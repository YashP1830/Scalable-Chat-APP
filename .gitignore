# =============================================================================
# ChatAppScalable — root .gitignore
# Single repo covering /backend and /frontend, so this file is the source of
# truth for both (each also has small package-specific ignores).
# =============================================================================

# ---- Dependencies -----------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/

# ---- Environment secrets — NEVER commit these -------------------------------
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ---- Build output -------------------------------------------------------------
frontend/dist/
frontend/dist-ssr/
backend/dist/
*.local

# ---- Logs ---------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---- Generated reports (recreated every run — not source) ---------------------
summary.json
loadtest-report*.json
loadtest-report*.html

# ---- Editor / OS junk -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Coverage / tool caches -----------------------------------------------------
coverage/
.eslintcache
.vite/

# ---- Personal/scratch build artifacts (sandbox-specific paths, not portable) ----
build_notes_pdf.py
_preview_*.png
